# ============================================================
# HavenQuill — AI Story & Screenplay Sanctuary
# ============================================================
# Copy this file to .env and configure your local settings.
# Direct API Key Generation Links:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
# NEVER commit .env to version control or share your API keys.

# Application Settings
APP_ENV=development
APP_NAME=HavenQuill
APP_DATA_DIR=./data

# AI Provider Settings
# Options: mock, gemini, groq
AI_PROVIDER=mock
AI_AUTO_FALLBACK=false

# Google Gemini Configuration (Primary Provider)
# Generate key: https://aistudio.google.com/apikey
# Suitable Models:
#   - gemini-3.8-flash (Recommended default: fast, rich prose, native JSON schema)
#   - gemini-3.5-flash-lite (High-speed economy reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq Configuration (Fallback Provider)
# Generate key: https://console.groq.com/keys
# Suitable Models:
#   - qwen/qwen3.8-27b (Verified default: top literary prose, ultra-fast generation)
#   - openai/gpt-oss-120b (High-parameter open weights model)
#   - whisper-large-v3 (Cloud audio transcription)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Voice & Speech-to-Text Transcription Settings
# Options:
#   - faster_whisper (Recommended: 100% local CPU Fast Whisper, isolated in ./data/whisper_models)
#   - groq           (Groq Cloud Whisper API: whisper-large-v3)
#   - gemini         (Gemini multimodal speech-to-text)
#   - mock           (Offline demo output)
#   - none           (Manual typing only)
ENABLE_CLOUD_TRANSCRIPTION=false
TRANSCRIPTION_PROVIDER=faster_whisper

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
