# ============================================================
# Storybook Studio (Creative Sanctuary) - Environment Configuration
# ============================================================
# Copy this file to .env and configure your local settings.
# Direct API Key Generation Links:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
# NEVER commit .env to version control or share your API keys.

# Application Settings
APP_ENV=development
APP_NAME=Storybook Studio
APP_DATA_DIR=./data

# AI Provider Settings
# Options: mock, gemini, groq
AI_PROVIDER=mock
AI_AUTO_FALLBACK=false

# Google Gemini Configuration (Primary Provider)
# Generate key: https://aistudio.google.com/apikey
# Suitable Models:
#   - gemini-2.5-flash (Recommended default: fast, rich prose, native JSON schema)
#   - gemini-3.8-flash (High-capability reasoning and multimodal speed)
#   - gemini-2.5-pro   (Deep narrative architecture and world building)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration (Fallback Provider)
# Generate key: https://console.groq.com/keys
# Suitable Models:
#   - llama-3.3-70b-versatile (Recommended default: top open-weights quality, ultra-fast)
#   - llama-3.1-8b-instant    (Ultra-fast draft prototyping)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Voice & Speech-to-Text Transcription Settings
# Options:
#   - faster_whisper (Recommended: 100% local CPU Fast Whisper, zero key required)
#   - groq           (Groq Cloud Whisper API: whisper-large-v3)
#   - gemini         (Gemini multimodal speech-to-text)
#   - mock           (Offline demo output)
#   - none           (Manual typing only)
ENABLE_CLOUD_TRANSCRIPTION=false
TRANSCRIPTION_PROVIDER=faster_whisper

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
