# ============================================================
# Storybook Studio - Environment Configuration Template
# ============================================================
# Copy this file to .env and configure your local settings.
# NEVER commit .env to version control or share your API keys.

# Application Settings
APP_ENV=development
APP_NAME=Storybook Studio
APP_DATA_DIR=./data

# AI Provider Settings
# Options: mock, gemini, groq
AI_PROVIDER=mock
AI_AUTO_FALLBACK=false

# Google Gemini Configuration
# Primary AI Provider
# Obtain key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Configuration
# Fallback AI Provider
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Voice & Audio Transcription Settings
# Options: none, gemini, groq
ENABLE_CLOUD_TRANSCRIPTION=false
TRANSCRIPTION_PROVIDER=none

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
